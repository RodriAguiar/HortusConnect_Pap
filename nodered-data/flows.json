        "z": "3dc5621d6220e1b5",
        "name": "Guardar leituras",
        "func": "\nlet sensores = flow.get(\"sensores\") || {};\n\nlet nomeSensor = msg.topic.split(\"/\").pop();\n\nsensores[nomeSensor] = msg.payload.valor;\n\nflow.set(\"sensores\", sensores);\n\nreturn null;",
