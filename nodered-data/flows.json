    {
        "id": "e3da8d8033709413",
        "type": "function",
        "z": "f6667c613d2c9cbf",
        "name": "Comando bomba",
        "func": "// Guardar a mensagem original\nlet pedidoOriginal = msg;\n\n// Validar o pedido\nif (typeof msg.payload.estado !== \"boolean\") {\n    msg.statusCode = 400;\n    msg.payload = {\n        erro: \"O campo estado deve ser true ou false.\"\n    };\n\n    return [null, msg];\n}\n\n// Criar mensagem MQTT\nlet mensagemMQTT = {\n    topic: \"estufa/atuadores/bomba\",\n    payload: JSON.stringify({\n        estado: msg.payload.estado\n    })\n};\n\n// Preparar resposta HTTP\nmsg.statusCode = 200;\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    sucesso: true,\n    atuador: \"bomba\",\n    estado: pedidoOriginal.payload.estado\n};\n\n// Enviar MQTT e resposta HTTP\nreturn [mensagemMQTT, msg];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
