    {
        "id": "sim_func",
        "type": "function",
        "z": "sim_tab",
        "name": "Gerar sensores",
        "func": "const s = context.get('s') || {ti:24, te:18, ha:60, hs:45, ch:0, nt:80};\nconst passo = (v, d, min, max) => Math.min(max, Math.max(min, v + (Math.random()*2-1)*d));\ns.ti = passo(s.ti, 0.4, 10, 40);\ns.te = passo(s.te, 0.3, 0, 35);\ns.ha = passo(s.ha, 1.5, 30, 95);\ns.hs = passo(s.hs, 1, 10, 90);\nif (s.ch > 0) { s.ch = Math.max(0, s.ch - 10); }\nelse if (Math.random() < 0.05) { s.ch = 60 + Math.round(Math.random()*40); }\ns.nt = passo(s.nt, 1, 0, 100);\ncontext.set('s', s);\nconst r = x => Math.round(x*10)/10;\nconst mk = (t, v) => ({topic: 'estufa/sensores/' + t, payload: {valor: v}});\nreturn [[\n  mk('temperatura_interior', r(s.ti)),\n  mk('temperatura_exterior', r(s.te)),\n  mk('humidade_ar', r(s.ha)),\n  mk('humidade_solo', r(s.hs)),\n  mk('chuva', Math.round(s.ch)),\n  mk('nivel_tanque', r(s.nt))\n]];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 80,
        "wires": [
            [
                "sim_mqtt"
            ]
        ]
